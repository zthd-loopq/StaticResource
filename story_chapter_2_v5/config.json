      "characterName": "Liam",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Some small company CEO. This is my party—stay out!",
      "characterName": "Blake",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Your IPO was all Scarlett's doing. She's the one who deserves the spotlight today.",
