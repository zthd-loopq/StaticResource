    },
    {
      "dialogue": "Don't touch her!",
      "characterName": "Liam",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "You're Liam? I remember you—we bid together, and your speech was amazing.",
      "characterName": "Scarlett",
      "characterImg": "result:y8d2n4x6",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
