  "front": [
    {
      "dialogue": "Who are you?",
      "characterName": "Scarlett",
      "characterImg": "result:h6r1k8p3",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Look! She's the owner of this place! A greedy businesswoman, destroy her!",
      "characterName": "Sam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Stand down. This is my mall, and I won’t let you hurt anyone here.",
      "characterName": "Scarlett",
      "characterImg": "result:h6r1k8p3",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "This outfit’s too much of a hindrance. To take control of this mess, I need something more practical for action.",
      "characterName": "Scarlett",
      "characterImg": "result:h6r1k8p3",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    }
  ],
  "result": {
