      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "You're an idiot. I bid 6 million!",
      "characterName": "Blake",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "8 million.",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "What? No way! I don't have that much liquidity!",
      "characterName": "Blake",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Oh, what an intense competition! Any other guests want to raise the bid?",
      "characterName": "Auctioneer",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "8 million, going once, going twice... Sold!",
      "characterName": "Auctioneer",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "The Pink Star is for you, my girlfriend.",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Liam, who are you exactly?",
      "characterName": "Scarlett",
      "characterImg": "result:r4t8n1v6",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
