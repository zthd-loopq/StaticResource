      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Liam! The auction was amazing, but the next event is an even better rock party!",
      "characterName": "Scarlett",
      "characterImg": "result:r4t8n1v6",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
