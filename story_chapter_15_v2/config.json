      "characterImg": "character_02.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "You’re the one after the Harrington family’s money!Liam, don’t pay attention to him.",
      "characterName": "Scarlett",
