      "characterName": "Liam",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "What? The Walton family, the century-old super-rich one?",
      "characterName": "Scarlett",
      "characterImg": "result:tjptce2j",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
