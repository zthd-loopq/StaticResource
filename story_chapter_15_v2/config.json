      "characterName": "Liam",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Wow, that's cool! I mean, it just gives us another thing in common!",
      "characterName": "Scarlett",
      "characterImg": "result:tjptce2j",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "You're right! I told you who I really am because I didn’t want to lie to you. It’s because I like you...",
      "characterName": "Liam",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "What? It’s too loud in here! I can’t hear you!",
      "characterName": "Scarlett",
      "characterImg": "result:tjptce2j",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
