  "behind": [
    {
      "dialogue": "As Scarlett enjoyed the long-awaited meal, she overheard the maids chatting.",
      "characterName": "special:narration",
      "backgroundImg": "bg_03.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Did you hear? Our young miss is back.",
      "characterName": "Cook",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "I know, Mrs. Vivian told us to keep an eye on her. I wonder why.",
      "characterName": "Maid",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "You newcomers wouldn't know, but back in the day, we all guessed that Miss Scarlett's mom's death had something to do with Vivian.",
      "characterName": "Cook",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Mrs. Vivian is so nervous, she must be afraid Miss Scarlett will come back and uncover the truth.",
      "characterName": "Cook",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Shh, stop talking...",
      "characterName": "Maid",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "The truth about my mother’s death? What?",
      "characterName": "Scarlett",
