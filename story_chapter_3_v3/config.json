  "front": [
    {
      "dialogue": "Scarlett's a billionaire heir? I actually divorced her... No! This can't be true!",
      "characterName": "Blake",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Remember? You said you wanted a divorce, and the papers were signed.",
      "characterName": "Scarlett",
      "characterImg": "result:m3k7p1w5",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Scarlett, I'll remarry you. Please forgive me.",
      "characterName": "Blake",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "You will remarry me? Who do you think you are? Get out.",
      "characterName": "Scarlett",
      "characterImg": "result:m3k7p1w5",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "I'm your husband! You can't do this to me!",
      "characterName": "Blake",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "You're not anymore. Edith, let's go.",
      "characterName": "Scarlett",
      "characterImg": "result:m3k7p1w5",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Yes, Miss.",
      "characterName": "Edith",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Scarlett and Edith walk away under the gaze of the crowd, heading back to the Harrington estate.",
      "characterName": "special:narration",
      "characterPos": 1
    },
    {
      "dialogue": "I've been away for years, and I can't believe the room still looks exactly the same.",
      "characterName": "Scarlett",
      "characterImg": "result:m3k7p1w5",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "I wasn't sure when you'd be home, so I've had someone clean every day.",
      "characterName": "Edith",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Home... Honestly, I'm still not sure if I should come back to this cold, heartless place.",
      "characterName": "Scarlett",
      "characterImg": "result:m3k7p1w5",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "I know you'll figure it out in time. But for now, why don't you change into something comfy for dinner?",
      "characterName": "Edith",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Thank you, Edith. You're the only one here who's been nice to me.",
      "characterName": "Scarlett",
      "characterImg": "result:m3k7p1w5",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    }
  ],
