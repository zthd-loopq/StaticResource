  "front": [
    {
      "dialogue": "What?! My husband is cheating on me with my sister?",
      "characterName": "Scarlett",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 1
    },
    {
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 1
    },
    {
      "dialogue": "He's gonna marry me.",
      "characterName": "Chloe",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Get out of my house! I'm divorcing you. We are done!",
      "characterName": "Blake",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Scarlett left the place that hurt her and went back to where she belonged.",
      "characterName": "special:narration",
      "backgroundImg": "bg_04.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Stop right there! This is the Harrington state. No beggars allowed!",
      "characterName": "Security Guard",
      "characterImg": "character_08.webp",
      "backgroundImg": "bg_05.webp",
      "characterPos": 2
    },
    {
      "dialogue": "I'm not a beggar. I'm the owner of this place.",
      "characterName": "Scarlett",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_05.webp",
      "characterPos": 0
    },
    {
      "dialogue": "My God, is that you, Miss Scarlett? You're finally back!",
      "characterName": "Edith",
      "characterImg": "character_09.webp",
      "backgroundImg": "bg_05.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Yes, it's me. It's so good to see you, Edith.",
      "characterName": "Scarlett",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_05.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Open the door, now.",
      "characterName": "Edith",
      "characterImg": "character_09.webp",
      "backgroundImg": "bg_05.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Yes, ma'am!",
      "characterName": "Security Guard",
      "characterImg": "character_10.webp",
      "backgroundImg": "bg_05.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Edith, Blake and I are divorced.",
      "characterName": "Scarlett",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_06.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Miss, don't say anything. First, go take a bath and change. I don't want you getting sick.",
      "characterName": "Edith",
      "characterImg": "character_09.webp",
      "backgroundImg": "bg_06.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Alright, lay out my most dazzling gowns and all my jewels. I'm going back to being the radiant Lady Spencer.",
      "characterName": "Scarlett",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_06.webp",
      "characterPos": 0
    }
  ],
