  "behind": [
    {
      "dialogue": "Miss Scarlett, how have you been? Your stepmother and sister only grew worse while you were away.",
      "characterName": "Edith",
      "characterImg": "character_09.webp",
      "backgroundImg": "bg_06.webp",
      "characterPos": 2
    },
    {
      "dialogue": "I can imagine. I left 'cause I hated their mess. I wanted a quiet life—but my sister had other plans! Fine, I'm fighting back!",
      "characterName": "Scarlett",
      "characterImg": "result:y8d2n4x6",
      "backgroundImg": "bg_06.webp",
      "characterPos": 0
    },
    {
      "dialogue": "It gladdens me to hear that, Miss. Do you have a plan?",
      "characterName": "Edith",
      "characterImg": "character_09.webp",
      "backgroundImg": "bg_06.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Blake’s company has its IPO celebration tomorrow. The perfect stage for my family comeback.",
      "characterName": "Scarlett",
      "characterImg": "result:y8d2n4x6",
      "backgroundImg": "bg_06.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Oh, I can’t wait to see Chloe and your ex-husband’s faces then!",
      "characterName": "Edith",
      "characterImg": "character_09.webp",
      "backgroundImg": "bg_06.webp",
      "characterPos": 2
    },
    {
      "dialogue": "The next day, Scarlett arrives at Blake's celebration party.",
      "characterName": "special:narration",
      "backgroundImg": "bg_07.webp"
    },
    {
      "dialogue": "Hold on! No invitation, no entry.",
      "characterName": "Waiter",
      "characterImg": "character_11.webp",
      "backgroundImg": "bg_07.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Blake invited all the city’s elite for his IPO, right?",
      "characterName": "Scarlett",
      "characterImg": "result:y8d2n4x6",
      "backgroundImg": "bg_07.webp",
      "characterPos": 0
    },
    {
      "dialogue": "VIPs don’t need invites—but you do. No way!",
      "characterName": "Waiter",
      "characterImg": "character_11.webp",
      "backgroundImg": "bg_07.webp",
      "characterPos": 2
    },
    {
      "dialogue": "I’m Mr. Harrington’s daughter! In this city, I can just—",
      "characterName": "Scarlett",
      "characterImg": "result:y8d2n4x6",
      "backgroundImg": "bg_07.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Cut it out! Everyone knows you’re just his ex-wife. The boss said never to let you in—don’t make me force you!",
      "characterName": "Waiter",
      "characterImg": "character_11.webp",
      "backgroundImg": "bg_07.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Blake, look! Isn’t that your ex-wife outside?",
      "characterName": "Chloe",
      "characterImg": "character_12.webp",
      "backgroundImg": "bg_07.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Scarlett! What are you doing here?! I know you still love me—but we’re over, got it?",
      "characterName": "Blake",
      "characterImg": "character_13.webp",
      "backgroundImg": "bg_07.webp",
      "characterPos": 2
    },
    {
      "dialogue": "You’re delusional. I’m not here to—",
      "characterName": "Scarlett",
      "characterImg": "result:y8d2n4x6",
      "backgroundImg": "bg_07.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Don’t listen to her! This shameless woman—throw her out!",
      "characterName": "Chloe",
      "characterImg": "character_12.webp",
      "backgroundImg": "bg_07.webp",
      "characterPos": 2
    }
