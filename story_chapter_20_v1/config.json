  "front": [
    {
      "dialogue": "Wait!Everyone, my girlfriend is Scarlett. There must have been some mistake.",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Liam!",
      "characterName": "Mrs. Walton",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "As the crowd gasped and whispered, Mrs. Walton drags Liam backstage.",
      "characterName": "special:narration",
      "backgroundImg": "bg_01.webp"
    },
    {
      "dialogue": "Mother! I explicitly told you I love Scarlett! Why would you announce Chloe?",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Scarlett disappeared for years, and she's a divorced woman. She's beneath you.",
      "characterName": "Mrs. Walton",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "None of that matters! I love her! She's the only one I want!",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Enough! Chloe is proper society. She will be your fiancée.",
      "characterName": "Mrs. Walton",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Security! Escort my son away. He's not to reappear tonight!",
      "characterName": "Mrs. Walton",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Liam...why? Was this your surprise for me...?",
      "characterName": "Scarlett",
      "characterImg": "result:j68cg0w0",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "How does it feel? Heartbroken? Devastated?",
      "characterName": "Chloe",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Liam doesn't love Chloe. How could you—",
      "characterName": "Scarlett",
      "characterImg": "result:j68cg0w0",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Love? That's irrelevant. What matters is my daughter becoming the future Mrs. Walton.",
      "characterName": "Vivian",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Exactly. I'll control both Harrington and Walton fortunes. While you get thrown out, sis~",
      "characterName": "Chloe",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Though if you beg, I might hire you...as a maid! Haha!",
      "characterName": "Vivian",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "How pathetic. Was this why my mother died?",
      "characterName": "Scarlett",
      "characterImg": "result:j68cg0w0",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "What did you just say?!",
      "characterName": "Vivian",
      "characterImg": "character_06.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Miss Scarlett! Emergency with the sports brand deal! We need you at the meeting!",
      "characterName": "Tiana",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Understood. Stall them. I'm coming.",
      "characterName": "Scarlett",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Liam... actually, never mind. Since Vivian's pushing me out, I've gotta focus on protecting the company now.First, change into proper business attire.",
      "characterName": "Scarlett",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
