  "front": [
    {
      "dialogue": "Tiffany, serve!",
      "characterName": "Chloe",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Heads up!",
      "characterName": "Tiffany",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "!!!",
      "characterName": "Scarlett",
      "characterImg": "result:f509qs9w",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "That's completely unfair! You can't aim at people!",
      "characterName": "Harper",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "You agreed to this. Backing out now? Remember - losers leave.",
      "characterName": "Chloe",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Harper, get ready. They're serving again.",
      "characterName": "Scarlett",
      "characterImg": "result:f509qs9w",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "But you could get hurt!",
      "characterName": "Harper",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Not if we return every shot.",
      "characterName": "Scarlett",
      "characterImg": "result:f509qs9w",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "As Scarlett concentrates on the game, this unusual match catches the attention of a nearby expert.",
      "characterName": "special:narration",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "That woman...she's countering under these conditions?",
      "characterName": "???",
      "characterImg": "character_06.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Final point - Scarlett! We won! Yes!",
      "characterName": "Harper",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Hmph!",
      "characterName": "Chloe",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Losing the match, Chloe \"accidentally\" hurls her racket across the court.",
      "characterName": "special:narration",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "What?!",
      "characterName": "Scarlett",
      "characterImg": "result:f509qs9w",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Look out!Intentionally harming others is the worst thing on a tennis court. Please leave - you're not welcome here.",
      "characterName": "???",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Not welcome? Do you know who I am?!",
      "characterName": "Chloe",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Whoever you are, this is my club, and I have every right to ban you.",
      "characterName": "???",
      "characterImg": "character_06.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "You'll regret this! Tiffany, we're leaving!",
      "characterName": "Chloe",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Thank you for your help, sir.",
      "characterName": "Scarlett",
      "characterImg": "result:f509qs9w",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Please, call me Daniel. To make up for that, let me treat you both to our VIP hot spring. I insist.",
      "characterName": "Daniel",
      "characterImg": "character_06.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Oh, wonderful!",
      "characterName": "Harper",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Then I guess I’ll have to dress up~",
      "characterName": "Scarlett",
      "characterImg": "result:f509qs9w",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
