  "behind": [
    {
      "dialogue": "How do I look? Is this okay?",
      "characterName": "Scarlett",
      "characterImg": "result:s5y8f2l4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "You look stunning... I mean, it's perfect.",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "I'd really love to invite you to dance at tonight's party.",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "If it’s you asking, I’ll say yes.",
      "characterName": "Scarlett",
      "characterImg": "result:s5y8f2l4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Is he really just the CEO of a small company?",
      "characterName": "Scarlett",
      "characterImg": "result:s5y8f2l4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Wait, how does Liam know there’s a party tonight? And he has a private jet?",
      "characterName": "Scarlett",
      "characterImg": "result:s5y8f2l4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Look, we’re here.",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Hello, Mrs. Walton.",
      "characterName": "Vivian",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Hello, Mrs. Harrington. I heard your stepdaughter’s back. Isn’t she coming to this event?",
      "characterName": "Mrs. Walton",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Don’t even mention it. She’s a total mess, there’s no way she’ll show up.",
      "characterName": "Vivian",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Oh, how uncouth... Wait, who’s that?",
      "characterName": "Mrs. Walton",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Oh, she's gorgeous!",
      "characterName": "Billionaire",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
