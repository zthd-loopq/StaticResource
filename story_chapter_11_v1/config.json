  "front": [
    {
      "dialogue": "The jet from home already left. I need to find another one…I’ll ask Edith first.",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Scarlett pulls out her phone and quickly dials Edith’s number.",
      "characterName": "special:narration",
      "backgroundImg": "bg_01.webp"
    },
    {
      "dialogue": "Edith, Vivian totally tricked me with a fake itinerary, and the whole family’s already gone!",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Can you help me find another jet to get me to the auction?",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Of course, Miss Scarlett. I may not be Edith, but I’d be happy to help.",
      "characterName": "Liam",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Liam?! Sorry. I was in such a rush, I must’ve dialed the wrong number.",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "No worries. Are you at the Harrington estate?",
      "characterName": "Liam",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Yes, but you don’t need to—",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "I’ll come pick you up. I’m headed to the auction on that island too, it’s on the way.",
      "characterName": "Liam",
      "characterImg": "character_07.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Oh, I really appreciate it.",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Soon, Liam's plane lands at the Harrington estate's helipad, and Scarlett boards the plane.",
      "characterName": "special:narration",
      "backgroundImg": "bg_02.webp"
    },
    {
      "dialogue": "I have to thank you again. This really solved a huge problem for me.",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "No need to mention it. But your problem isn’t completely solved yet.",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "What do you mean?",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "The auction we’re going to is on an island. The first day requires us to wear resort-style outfits.",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "ou know, the upper crust loves to mock anyone who doesn’t follow the rules...",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Oh! My clothes are all wrong!",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "I have some clothes for women on board. Feel free to use them.",
      "characterName": "Liam",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Thank you! I’ll go change right now.",
      "characterName": "Scarlett",
      "characterImg": "result:a9w3d6j1",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    }
  ],
