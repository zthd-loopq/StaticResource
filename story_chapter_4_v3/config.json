      "characterName": "Scarlett",
      "characterImg": "result:b9v4z2r8",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Hmph, she really thinks she's the lady of the house.",
      "characterName": "Head Maid",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "This house is full of Vivian's spies. I need to come up with a way to investigate.",
