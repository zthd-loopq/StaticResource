  "behind": [
    {
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 1
    },
    {
      "dialogue": "Have you finally realized that this family is everything to you and decided to come back?",
      "characterName": "Mr. Harrington",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "..Yes, Father.",
      "characterName": "Scarlett",
      "characterImg": "result:t5u2j7k4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Hmph. So what if you're back? You even lost your husband to me—Mom! Why did you step on me?",
      "characterName": "Chloe",
      "characterImg": "character_05.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Scarlett, as your stepmother, I hope you won't be as stubborn as before.",
      "characterName": "Vivian",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "That vicious woman! No... I must hold it in.",
      "characterName": "Scarlett",
      "characterImg": "result:t5u2j7k4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "After all these years, I've really grown a lot. I hope Father can give me a chance to prove myself.",
      "characterName": "Scarlett",
      "characterImg": "result:t5u2j7k4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "You wasted a lot of time being an ordinary person. What kind of ability do you have?",
      "characterName": "Mr. Harrington",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Please pick a struggling business from the family company for me.",
      "characterName": "Scarlett",
      "characterImg": "result:t5u2j7k4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "After becoming CEO, I will turn it around in six months and prove myself.",
      "characterName": "Scarlett",
      "characterImg": "result:t5u2j7k4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Darling, Scarlett should still stay at home...",
      "characterName": "Vivian",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Sounds like I'm not losing anything. I agree. Go ahead and take charge in a few days.",
      "characterName": "Mr. Harrington",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Yes, Father.",
      "characterName": "Scarlett",
      "characterImg": "result:t5u2j7k4",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Scarlett, since you're so ambitious, let's see how you handle my methods.",
      "characterName": "Vivian",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_02.webp",
      "characterPos": 2
    }
  ]
