  "front": [
    {
      "dialogue": "Who's there—Miss Scarlett? What are you doing here?",
      "characterName": "Edith",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Oh, it's you. I heard that there was more to my mother's accidental death, so I came to investigate.",
      "characterName": "Scarlett",
      "characterImg": "result:s1f6g3h9",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Miss, do you already know?",
      "characterName": "Edith",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Know what? Edith, tell me!",
      "characterName": "Scarlett",
      "characterImg": "result:s1f6g3h9",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "After your mother's accident, on the way to the hospital, she told me it was Vivian who caused it.",
      "characterName": "Edith",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Why didn't you tell me this before?!",
      "characterName": "Scarlett",
      "characterImg": "result:s1f6g3h9",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "If you didn't know about all this, maybe you could've grown up safer. That was also your mother's wish.",
      "characterName": "Edith",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Mom... Vivian! Why did she want to kill my mom? Was it just for the Harrington family's fortune?!",
      "characterName": "Scarlett",
      "characterImg": "result:s1f6g3h9",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Only she knows the truth, Miss, don't be too sad.",
      "characterName": "Edith",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "No, I must find out the truth! And the Harrington family's fortune—I'll take it back!",
      "characterName": "Scarlett",
      "characterImg": "result:s1f6g3h9",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "I won't let Vivian get away with this. I must return to the family to avenge my mother.",
      "characterName": "Scarlett",
      "characterImg": "result:s1f6g3h9",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Miss Scarlett. If this is your wish, I will help you to the best of my ability.",
      "characterName": "Edith",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Mr. Harrington will return home tomorrow. Perhaps you should meet him.",
      "characterName": "Edith",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "That profit-driven father of mine? I'll make good preparations.",
      "characterName": "Scarlett",
      "characterImg": "result:s1f6g3h9",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "The next day",
      "characterName": "special:narration"
    },
    {
      "dialogue": "Now, to greet my father, I should change into something more appropriate.",
      "characterName": "Scarlett",
      "characterImg": "result:s1f6g3h9",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    }
