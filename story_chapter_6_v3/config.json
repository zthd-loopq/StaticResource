  "front": [
    {
      "dialogue": "You're going to the company today. I heard it's a high-end mall that's been losing money for a while.",
      "characterName": "Edith",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Yes, it's not an easy challenge. But I'll do my best.",
      "characterName": "Scarlett",
      "characterImg": "result:t5u2j7k4",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    },
    {
      "dialogue": "I've prepared a few outfits for you. I hope they'll help you face the challenge more confidently.",
      "characterName": "Edith",
      "characterImg": "character_01.webp",
      "backgroundImg": "bg_01.webp",
      "characterPos": 2
    },
    {
      "dialogue": "That's great! I'll change right now.",
      "characterName": "Scarlett",
      "characterImg": "result:t5u2j7k4",
      "backgroundImg": "bg_01.webp",
      "characterPos": 0
    }
  ],
