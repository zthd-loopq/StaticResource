  "behind": [
    {
      "dialogue": "After everything was ready, Scarlett arrived at the company she was about to take over.",
      "characterName": "special:narration",
      "characterPos": 1
    },
    {
      "dialogue": "She quickly discovered that Manager Sam's arrangements for the employees were highly unreasonable, yet he had submitted an incredibly valuable business proposal.",
      "characterName": "special:narration",
      "backgroundImg": "bg_02.webp",
      "characterPos": 1
    },
    {
      "dialogue": "This is suspicious. I should go meet him.",
      "characterName": "Scarlett",
      "characterImg": "result:q0w8e4r6",
      "backgroundImg": "bg_02.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Tiana, my coffee.",
      "characterName": "Manager Sam",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Yes, Mr. Sam.",
      "characterName": "Tiana",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "My desk is dirty, clean it.",
      "characterName": "Manager Sam",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Yes, Mr. Sam.",
      "characterName": "Tiana",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Is my report ready?",
      "characterName": "Manager Sam",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "No, Mr. Sam...",
      "characterName": "Tiana",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "It's been the whole night and you still haven't finished? How did your efficiency get so bad?",
      "characterName": "Manager Sam",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Mr. Sam, I don't want to write documents for you anymore.",
      "characterName": "Tiana",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Shut up! A woman like you, ugly and fat, the only reason I gave you a job is because I felt sorry for you!",
      "characterName": "Manager Sam",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "If you don't want to write for me, get ready to be fired! So, what's it gonna be?",
      "characterName": "Manager Sam",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "...I'll have it done today.",
      "characterName": "Tiana",
      "characterImg": "character_03.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "No, you don't need to do his job. You'll be the manager.",
      "characterName": "Scarlett",
      "characterImg": "result:q0w8e4r6",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "What? You are—",
      "characterName": "Tiana",
      "characterImg": "character_04.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "Sweetheart, this is the manager's office. No outsiders allowed.",
      "characterName": "Manager Sam",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "I'm your CEO.",
      "characterName": "Scarlett",
      "characterImg": "result:q0w8e4r6",
      "backgroundImg": "bg_03.webp",
      "characterPos": 0
    },
    {
      "dialogue": "You? CEO? Ha! I think you'd be more suited to be my mistress.",
      "characterName": "Manager Sam",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    },
    {
      "dialogue": "Guards! Get this bitch out of here!",
      "characterName": "Manager Sam",
      "characterImg": "character_02.webp",
      "backgroundImg": "bg_03.webp",
      "characterPos": 2
    }
  ]
